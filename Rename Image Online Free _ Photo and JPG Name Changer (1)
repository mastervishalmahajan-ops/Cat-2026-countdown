.nav-btn:hover:not(:disabled) { background: var(--primary-hover); }

.nav-btn:disabled { opacity: 0.4; cursor: not-allowed; }

.nav-btn svg { width: 16px; height: 16px; fill: white; }

.nav-info { text-align: center; font-size: 13px; color: var(--text-light); font-weight: 500; white-space: nowrap; }

.preview-row { display: flex; flex-direction: column; gap: 8px; padding: 12px; background: var(--bg-main); border-radius: 8px; border: 1px solid var(--border-light); margin-top: 15px; margin-bottom: 5px; }

.preview-label { font-size: 12px; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }

.preview-value { font-family: "SF Mono", Monaco, Consolas, monospace; font-size: 14px; color: var(--primary); font-weight: 600; word-break: break-all; }

.file-item { padding: 12px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 10px; background: var(--bg-main); transition: 0.2s; cursor: pointer; }

.file-item:hover { border-color: var(--primary); background: var(--bg-white); }

.file-item.active { border-color: var(--primary); background: rgba(0, 122, 255, 0.05); }

.file-item-content { display: flex; align-items: center; gap: 10px; }

.file-item-preview { width: 50px; height: 50px; border-radius: 6px; object-fit: cover; flex-shrink: 0; border: 1px solid var(--border); }

.file-item-details { flex: 1 1 0%; min-width: 0px; }

.file-item-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 12px; color: var(--text-light); }

.file-item-number { font-weight: 600; color: var(--primary); }

.file-item-ext { background: var(--border); padding: 2px 6px; border-radius: 4px; font-size: 11px; text-transform: uppercase; }

.file-item input[type="text"] { font-size: 13px; padding: 8px; width: 100%; }

.rename-mode-selector { margin-bottom: 15px; }

.rename-mode-content { display: none; }

.rename-mode-content.active { display: block; }

.toggle-label { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; border: 2px solid var(--border); border-radius: 8px; background: var(--bg-white); transition: 0.2s; cursor: pointer; margin-bottom: 12px; }

.toggle-label:hover { border-color: var(--primary); box-shadow: rgba(0, 122, 255, 0.08) 0px 2px 6px; }

.toggle-label span { font-size: 14px; font-weight: 500; color: var(--text-dark); }

.toggle-switch { position: relative; display: inline-block; width: 50px; height: 26px; }

.toggle-switch input { opacity: 0; width: 0px; height: 0px; }

.toggle-slider { position: absolute; cursor: pointer; inset: 0px; background-color: var(--border); transition: 0.3s; border-radius: 26px; }

.toggle-slider::before { position: absolute; content: ""; height: 18px; width: 18px; left: 4px; bottom: 4px; background-color: rgb(255, 255, 255); transition: 0.3s; border-radius: 50%; }

input:checked + .toggle-slider { background-color: var(--success); }

input:checked + .toggle-slider::before { transform: translateX(24px); }

.spinner { width: 20px; height: 20px; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-left-color: ; border-left-style: ; border-left-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-top-color: rgb(255, 255, 255); border-radius: 50%; animation: 0.6s linear 0s infinite normal none running spin; display: inline-block; vertical-align: middle; margin-right: 8px; }

@keyframes spin { 
  100% { transform: rotate(360deg); }
}

@media (max-width: 968px) {
  :root { --spacing-md: 20px; --spacing-xl: 40px; --spacing-xxl: 60px; }
  .nav { display: none; }
  .hamburger { display: flex; }
  .mobile-actions { display: flex; }
  .tool-title { font-size: 32px; }
  .tool-description { font-size: 16px; margin-bottom: var(--spacing-xl); }
  .btn-primary { padding: 18px 50px; font-size: 18px; }
  .workspace { flex-direction: column; }
  .controls { width: 100%; max-height: none; overflow: visible; border-radius: 10px; }
  .canvas-area { width: fit-content; max-width: 100%; margin: 0px auto; }
  .canvas-wrapper { min-height: 200px; height: 35vh; max-height: 35vh; }
  .controls-scroll { overflow: visible; max-height: none; padding: 15px 15px 0px; }
  .controls-actions { padding: 10px 15px 15px; border-top-width: medium; border-top-style: none; border-top-color: currentcolor; }
  .control-group { margin-bottom: 12px; }
  .control-label { margin-bottom: 6px; font-size: 13px; }
  input[type="number"], input[type="text"] { padding: 8px 10px; }
  .preview-row { padding: 10px; margin-top: 10px; gap: 4px; }
  .preview-label { font-size: 11px; }
  .preview-value { font-size: 13px; }
  .btn { padding: 10px; font-size: 14px; margin-top: 0px; }
}

